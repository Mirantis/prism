// Agent-runtime schema (SQLite).
// Each container owns a file-backed DB (DATABASE_URL=file:/data/agent.db
// by default). MemoryEntry.embedding is Bytes? (packed Float32Array);
// vector search happens via the `memory_entry_vec` vec0 virtual table
// (not modeled in Prisma — created at runtime via better-sqlite3 +
// sqlite-vec).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum AgentStatus {
  IDLE
  RUNNING
}

enum AgentHeartbeatStatus {
  ENABLED
  STOPPED
}

enum MessageRole {
  USER
  AGENT
  SYSTEM
}

enum MessageTrigger {
  USER_INPUT
  HEARTBEAT
  CRON_TASK
  SYSTEM
}

enum ThreadSource {
  DATABASE
  SLACK
}

enum AgentType {
  AGENT
  SUBAGENT
}

// ============================================================================
// Agent Workspace
// ============================================================================

model AgentWorkspace {
  id        String    @id @default(uuid())
  userId    String
  name      String    @default("Prism Agent")
  agentType AgentType @default(AGENT)

  soulMd      String
  userMd      String
  memoryMd    String
  heartbeatMd String
  visionMd    String @default("")
  agentMd     String @default("")

  bootstrapMd String

  heartbeatIntervalMs Int                  @default(28800000)
  heartbeatStatus     AgentHeartbeatStatus @default(ENABLED)
  proactivity         Int                  @default(3)
  verbosity           Int                  @default(3)
  timezone            String               @default("UTC")
  model               String?

  dailyResetHour  Int  @default(4)
  idleTimeoutMins Int?

  nexusMcpAgentToken String?
  nexusAgentTokenId  String?

  status           AgentStatus @default(IDLE)
  lastHeartbeat    DateTime?
  currentSessionId String?

  threads                ConversationThread[]
  cronTasks              CronTask[]
  memoryEntries          MemoryEntry[]
  slackMappings          SlackMapping[]
  slackVerificationCodes SlackVerificationCode[]
  slackHeartbeatTriggers SlackHeartbeatTrigger[]
  pendingSlackMessages   PendingSlackMessage[]
  subagentLinks          AgentSubagent[]         @relation("ParentAgent")
  parentAgentLinks       AgentSubagent[]         @relation("ChildAgent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("agent_workspaces")
}

// ============================================================================
// Conversations
// ============================================================================

model ConversationThread {
  id      String  @id @default(uuid())
  agentId String
  userId  String
  title   String?

  externalThreadId String?

  threadSource      ThreadSource @default(DATABASE)
  externalChannelId String?

  // Optional working directory this conversation is rooted in, set once at
  // creation (e.g. the CLI's launch cwd). Shell tools use it as their cwd when
  // present, else fall back to the global SHELL_WORKSPACE_ROOT. Never changed
  // after create.
  workspaceRoot String?

  compactionSummary String?
  compactedAt       DateTime?

  messages ConversationMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentWorkspace AgentWorkspace            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  participants   ConversationParticipant[]

  @@unique([agentId, userId, externalThreadId])
  @@map("conversation_threads")
}

model ConversationMessage {
  id          String         @id @default(uuid())
  threadId    String
  role        MessageRole
  content     String
  triggeredBy MessageTrigger
  toolCalls   Json?
  blocks      Json?
  tokenCount  Int?

  senderExternalId  String?
  senderName        String?
  externalMessageId String?

  isCompacted Boolean @default(false)

  createdAt DateTime @default(now())

  thread      ConversationThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments MessageAttachment[]

  @@map("conversation_messages")
}

// Shared files uploaded by users (web drag-and-drop or Slack attachments).
// Bytes are stored as a BLOB in this DB (safer than disk; survives restarts).
// `messageId` is nullable: web uploads land before the message is sent, then
// get linked at send time. `externalTs` re-associates Slack channel files with
// the live-read history (the SlackThreadProvider keys messages by Slack ts and
// never reads our message rows). `category` is denormalized so the context
// loader doesn't re-sniff the mediaType on every turn.
model MessageAttachment {
  id          String  @id @default(uuid())
  messageId   String?
  threadId    String?
  filename    String
  mediaType   String
  sizeBytes   Int
  category    String
  data        Bytes
  source      String
  // Unique so concurrent Slack event redeliveries (at-least-once) can't insert
  // the same file twice — the existsBySlackFileId() pre-check is a TOCTOU
  // fast-path, not the guarantee. Nullable web uploads are unconstrained
  // (SQLite treats NULLs as distinct). One Slack workspace per container, so a
  // single-column unique is sufficient (no per-connection scoping needed).
  slackFileId String? @unique
  externalTs  String?

  createdAt DateTime @default(now())

  message ConversationMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([threadId])
  @@index([externalTs])
  @@map("message_attachments")
}

model ConversationParticipant {
  id             String   @id @default(uuid())
  threadId       String
  externalUserId String
  displayName    String?
  channel        String
  joinedAt       DateTime @default(now())

  thread ConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, externalUserId, channel])
  @@map("conversation_participants")
}

// ============================================================================
// Cron Tasks
// ============================================================================

model CronTask {
  id      String @id @default(uuid())
  agentId String
  userId  String

  name        String
  schedule    String
  instruction String

  isActive  Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("cron_tasks")
}

// ============================================================================
// Memory System
// ============================================================================
//
// SQLite note: `embedding` holds a packed Float32Array as BLOB. Vector
// search does NOT go through Prisma — use the `memory_entry_vec` vec0
// virtual table via sqlite-vec. See src/lib/sqlite-bootstrap.ts for
// setup and src/services/memory-store.ts for the query path.

model MemoryEntry {
  id         String   @id @default(uuid())
  agentId    String
  content    String
  category   String
  importance Int      @default(5)
  embedding  Bytes?
  createdAt  DateTime @default(now())

  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([agentId, category])
  @@map("memory_entries")
}

// ============================================================================
// Slack mappings, verification codes, heartbeat triggers, pending messages,
// subagents — same structure as Postgres, just no @db.Text.
// ============================================================================

model SlackMapping {
  id           String @id @default(uuid())
  connectionId String
  agentId      String

  slackUserId String?
  lensUserId  String?
  dmChannelId String?

  slackChannelId   String? @unique
  slackChannelName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([connectionId, slackUserId])
  @@index([connectionId])
  @@index([lensUserId])
  @@index([agentId])
  @@map("slack_mappings")
}

enum SlackVerificationType {
  DM
  CHANNEL
}

model SlackVerificationCode {
  id           String                @id @default(uuid())
  code         String
  type         SlackVerificationType
  lensUserId   String
  connectionId String
  agentId      String
  agentName    String?
  expiresAt    DateTime

  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([code, type])
  @@index([expiresAt])
  @@index([connectionId])
  @@index([agentId])
  @@map("slack_verification_codes")
}

model AgentSubagent {
  id            String @id @default(uuid())
  parentAgentId String
  childAgentId  String
  description   String @default("")

  parentAgentWorkspace AgentWorkspace @relation("ParentAgent", fields: [parentAgentId], references: [id], onDelete: Cascade)
  childAgentWorkspace  AgentWorkspace @relation("ChildAgent", fields: [childAgentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([parentAgentId, childAgentId])
  @@index([parentAgentId])
  @@index([childAgentId])
  @@map("agent_subagents")
}

model SlackHeartbeatTrigger {
  id               String    @id @default(uuid())
  connectionId     String
  slackChannelId   String    @unique
  slackChannelName String?
  agentId          String    @unique
  userId           String
  isActive         Boolean   @default(true)
  throttleSeconds  Int       @default(60) @map("throttle_seconds")
  lastTriggeredAt  DateTime? @map("last_triggered_at")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([userId])
  @@map("slack_heartbeat_triggers")
}

model PendingSlackMessage {
  id        String   @id @default(uuid())
  agentId   String
  sender    String
  text      String
  timestamp String
  createdAt DateTime @default(now())

  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@map("pending_slack_messages")
}
