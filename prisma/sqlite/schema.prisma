// Agent-runtime schema (SQLite).
// Each container owns a file-backed DB (DATABASE_URL=file:/data/agent.db
// by default). MemoryEntry.embedding is Bytes? (packed Float32Array);
// vector search happens via the `memory_entry_vec` vec0 virtual table
// (not modeled in Prisma — created at runtime via better-sqlite3 +
// sqlite-vec).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum AgentStatus {
  IDLE
  RUNNING
}

enum AgentHeartbeatStatus {
  ENABLED
  STOPPED
}

enum MessageRole {
  USER
  AGENT
  SYSTEM
}

enum MessageTrigger {
  USER_INPUT
  HEARTBEAT
  CRON_TASK
  GOAL
  WEBHOOK
  // Retained for historical rows; no code produces it. Prisma throws
  // "Value 'SYSTEM' not found in enum 'MessageTrigger'" when it reads a row whose
  // value the schema does not declare, and live databases hold such rows.
  SYSTEM
}

enum ThreadSource {
  DATABASE
  SLACK
}

enum AgentType {
  AGENT
  SUBAGENT
}

// ============================================================================
// Agent Workspace
// ============================================================================

model AgentWorkspace {
  id        String    @id @default(uuid())
  userId    String
  name      String    @default("Prism Agent")
  agentType AgentType @default(AGENT)

  soulMd      String
  userMd      String
  memoryMd    String
  heartbeatMd String
  visionMd    String @default("")
  agentMd     String @default("")

  bootstrapMd String

  heartbeatIntervalMs Int                  @default(28800000)
  heartbeatStatus     AgentHeartbeatStatus @default(ENABLED)
  timezone            String               @default("UTC")
  model               String?
  heartbeatModel      String?
  cronModel           String?

  dailyResetHour  Int  @default(4)
  idleTimeoutMins Int?

  // Inbound webhook receiver master switch (the Webhooks page "Enable
  // Webhooks" button). Off by default; POST /agents/webhooks/:name rejects
  // with 403 while disabled.
  webhooksEnabled Boolean @default(false)

  // When false (default), only the final text step of a multi-step chat turn
  // is delivered to the channel; intermediate steps are persisted but not
  // published. When true, every text step is delivered as it arrives.
  verbose Boolean @default(false)

  // Locked-in mode (the Profile page toggle). Off by default; while on, the
  // agent's own tools cannot rewrite the workspace markdown fields (soulMd,
  // memoryMd, userMd, visionMd, heartbeatMd, bootstrapMd) — those tools are
  // withheld and their writes refused. Vector memory, behavioural settings and
  // renames stay editable, and the human REST/UI toggle always works.
  lockedIn Boolean @default(false)

  nexusMcpAgentToken String?
  nexusAgentTokenId  String?

  status        AgentStatus @default(IDLE)
  lastHeartbeat DateTime?

  // When the next heartbeat check is due. Written by every recorded cycle and
  // by a cadence change, and read at boot so the next process arms the same
  // deadline. Distinct from lastHeartbeat, which is the last check that really
  // ran: a cadence change moves the deadline without claiming a run. Null on a
  // row that predates the column, and then the deadline comes off lastHeartbeat.
  nextHeartbeatAt DateTime?

  currentSessionId String?

  threads                ConversationThread[]
  cronTasks              CronTask[]
  goals                  Goal[]
  memoryEntries          MemoryEntry[]
  llmCalls               LlmCall[]
  documentRevisions      AgentWorkspaceRevision[]
  slackMappings          SlackMapping[]
  slackVerificationCodes SlackVerificationCode[]
  slackHeartbeatTriggers SlackHeartbeatTrigger[]
  pendingSlackMessages   PendingSlackMessage[]
  teamsMappings          TeamsMapping[]
  teamsVerificationCodes TeamsVerificationCode[]
  webhookSubscriptions   WebhookSubscription[]
  subagentLinks          AgentSubagent[]         @relation("ParentAgent")
  parentAgentLinks       AgentSubagent[]         @relation("ChildAgent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("agent_workspaces")
}

// One snapshot of one identity document, written by every accepted write to
// `soulMd`, `userMd`, `memoryMd`, `heartbeatMd`, `visionMd`, `agentMd` or
// `bootstrapMd`. Append-only: a restore writes a new row rather than removing
// the rows after it, so no step of the history is lost.
//
// `field` is the column name, `actor` is `agent` or `user`, and `method` is
// `seed`, `replace`, `edit`, `clear`, `rest` or `rollback` — the same words
// the `agent config updated` event already carries.
//
// Each document keeps its 500 newest revisions. The insert deletes anything
// older in the same transaction (services/document-revision.service.ts).
model AgentWorkspaceRevision {
  id          String   @id @default(uuid())
  agentId     String
  field       String
  content     String
  actor       String
  method      String
  reason      String
  createdAt   DateTime @default(now())

  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, field, createdAt])
  @@map("agent_workspace_revisions")
}

// ============================================================================
// Conversations
// ============================================================================

model ConversationThread {
  id      String  @id @default(uuid())
  agentId String
  userId  String
  title   String?

  externalThreadId String?

  threadSource      ThreadSource @default(DATABASE)
  externalChannelId String?

  // Optional working directory this conversation is rooted in, set once at
  // creation (e.g. the CLI's launch cwd). Shell tools use it as their cwd when
  // present, else fall back to the global SHELL_WORKSPACE_ROOT. Never changed
  // after create.
  workspaceRoot String?

  compactionSummary String?
  compactedAt       DateTime?

  // Provider-native compaction watermark: the position up to which this
  // thread's history is folded into `compactionSummary`. SLACK threads store
  // the Slack ts of the newest compacted reply — the live conversations.replies
  // read passes it as `oldest`. DATABASE threads store the newest compacted
  // row's createdAt as ISO text (informational; the per-row isCompacted flag
  // is authoritative there). A string because Slack ts and wall-clock DateTime
  // don't share a clock.
  compactedThroughTs String?

  // Last measured prompt size for this thread, written once per turn: the
  // provider-reported input tokens (already inclusive of cache reads/writes)
  // plus that step's output tokens. A per-turn SNAPSHOT, not a running total —
  // do not sum it. Drives the context-usage indicator, which recomputes the
  // percentage against `contextModel`'s window on read so a stale number is
  // never reinterpreted against a different model.
  contextTokens Int?
  contextModel  String?

  messages  ConversationMessage[]
  goals     Goal[]
  cronTasks CronTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentWorkspace AgentWorkspace            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  participants   ConversationParticipant[]

  @@unique([agentId, userId, externalThreadId])
  @@map("conversation_threads")
}

model ConversationMessage {
  id          String         @id @default(uuid())
  threadId    String
  role        MessageRole
  content     String
  triggeredBy MessageTrigger
  toolCalls   Json?
  blocks      Json?

  senderExternalId  String?
  senderName        String?
  externalMessageId String?

  isCompacted Boolean @default(false)

  // Concise mode persists intermediate multi-step text as its own AGENT row but
  // does not deliver it to the channel. `internalStep` marks such rows so client
  // history reads hide them, while the model-context read still replays them.
  internalStep Boolean @default(false)

  createdAt DateTime @default(now())

  thread      ConversationThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments MessageAttachment[]

  @@index([role, createdAt])
  @@map("conversation_messages")
}

// Shared files uploaded by users (web drag-and-drop or Slack attachments).
// Bytes are stored as a BLOB in this DB (safer than disk; survives restarts).
// `messageId` is nullable: web uploads land before the message is sent, then
// get linked at send time. `externalTs` re-associates Slack channel files with
// the live-read history (the SlackThreadProvider keys messages by Slack ts and
// never reads our message rows). `category` is denormalized so the context
// loader doesn't re-sniff the mediaType on every turn.
model MessageAttachment {
  id          String  @id @default(uuid())
  messageId   String?
  threadId    String?
  filename    String
  mediaType   String
  sizeBytes   Int
  category    String
  // Legacy BLOB storage. New rows keep bytes on disk (storagePath below) and
  // leave this null; a boot-time backfill migrates old rows. Both null =
  // content expired (the 168h TTL sweep) — the metadata row stays for history.
  data        Bytes?
  // Basename of the content file under <dataDir>/media (see lib/media-store.ts).
  storagePath String?
  source      String
  // Unique so concurrent Slack event redeliveries (at-least-once) can't insert
  // the same file twice — the existsBySlackFileId() pre-check is a TOCTOU
  // fast-path, not the guarantee. Nullable web uploads are unconstrained
  // (SQLite treats NULLs as distinct). One Slack workspace per container, so a
  // single-column unique is sufficient (no per-connection scoping needed).
  slackFileId String? @unique
  externalTs  String?

  createdAt DateTime @default(now())

  message ConversationMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([threadId])
  @@index([externalTs])
  @@map("message_attachments")
}

model ConversationParticipant {
  id             String   @id @default(uuid())
  threadId       String
  externalUserId String
  displayName    String?
  channel        String
  joinedAt       DateTime @default(now())

  thread ConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, externalUserId, channel])
  @@map("conversation_participants")
}

// ============================================================================
// Cron Tasks
// ============================================================================

model CronTask {
  id      String @id @default(uuid())
  agentId String
  userId  String

  name        String
  schedule    String
  instruction String

  isActive  Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?

  // When set, this (one-shot) task continues the originating conversation in
  // its own thread instead of the user's latest thread — the "wait & resume
  // here" capability.
  threadId        String?
  originChannel   String?
  originChannelId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentWorkspace AgentWorkspace      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  thread         ConversationThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("cron_tasks")
}

// ============================================================================
// Goals
// ============================================================================
//
// A durable objective the agent pursues autonomously across many turns until a
// cheap classification gate judges it complete, or it hits a turn/token/stall
// cap. One active goal per thread (enforced in GoalService.startGoal). The
// background continuation loop lives in goal.service.ts, modeled on the
// heartbeat re-trigger loop. Cascades from both the agent and the thread, so
// deleting either removes the goal row (the running loop is also aborted
// explicitly via goalService.stopGoal on thread archive/delete).

model Goal {
  id       String @id @default(uuid())
  agentId  String
  userId   String
  threadId String

  objective String

  // active | complete | blocked | budget_limited | turn_limited | paused | stopped
  status String @default("active")

  tokenBudget Int?
  tokensUsed  Int @default(0)
  turnCount   Int @default(0)
  maxTurns    Int

  // Consecutive zero-progress turns; goal is blocked once this hits GOAL_MAX_STALL_TURNS.
  stallCount Int @default(0)
  // Latest loop/gate reason (why it continued, blocked, or stopped) — surfaced in status.
  lastReason String?

  // Originating channel (REQUIRED) used for scoped delivery of goal-turn output.
  originChannel String // 'slack' | 'websocket'
  // Nullable: absent for Slack DMs (delivery falls back to the DM mapping).
  originChannelId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  agentWorkspace AgentWorkspace     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  thread         ConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([agentId, status])
  @@index([threadId])
  @@map("goals")
}

// ============================================================================
// LLM calls
// ============================================================================
//
// One row per model call, written when the call returns rather than when its
// output is delivered, so a suppressed heartbeat and a compaction count too.
// `inputTokens` already includes cache reads and writes, so a cache hit rate
// divides `cacheReadTokens` by the sum of the three details. The table is
// append-only and never pruned; a row is ~100 bytes.

model LlmCall {
  id String @id @default(uuid())

  /// Who paid: always the agent this runtime owns, and what reads filter on.
  agentId String

  /// Which subagent the call ran for; a plain id, so a deletion keeps the row.
  subagentId String?

  /// What the call was for; `LLM_CALL_PURPOSES` is the list.
  purpose String
  model   String

  threadId String?

  totalTokens      Int @default(0)
  inputTokens      Int @default(0)
  outputTokens     Int @default(0)
  cacheReadTokens  Int @default(0)
  cacheWriteTokens Int @default(0)
  noCacheTokens    Int @default(0)

  createdAt DateTime @default(now())

  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@map("llm_calls")
}

// ============================================================================
// Memory System
// ============================================================================
//
// SQLite note: `embedding` holds a packed Float32Array as BLOB. Vector
// search does NOT go through Prisma — use the `memory_entry_vec` vec0
// virtual table via sqlite-vec. See src/lib/sqlite-bootstrap.ts for
// setup and src/services/memory-store.ts for the query path.

model MemoryEntry {
  id         String   @id @default(uuid())
  agentId    String
  content    String
  category   String
  importance Int      @default(5)
  embedding  Bytes?
  createdAt  DateTime @default(now())

  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([agentId, category])
  @@map("memory_entries")
}

// ============================================================================
// Slack mappings, verification codes, heartbeat triggers, pending messages,
// subagents — same structure as Postgres, just no @db.Text.
// ============================================================================

model SlackMapping {
  id           String @id @default(uuid())
  connectionId String
  agentId      String

  slackUserId String?
  lensUserId  String?
  dmChannelId String?

  slackChannelId   String? @unique
  slackChannelName String?

  // Team mode: the agent's "main" channel — where heartbeat alerts (and
  // scheduled tasks with no resolvable origin channel) are posted. At most one
  // channel mapping per agent is flagged; delivery falls back to the oldest
  // linked channel when none is flagged (see slackMappingService.getMainChannel).
  isMainChannel Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([connectionId, slackUserId])
  @@index([connectionId])
  @@index([lensUserId])
  @@index([agentId])
  @@map("slack_mappings")
}

enum SlackVerificationType {
  DM
  CHANNEL
}

model SlackVerificationCode {
  id           String                @id @default(uuid())
  code         String
  type         SlackVerificationType
  lensUserId   String
  connectionId String
  agentId      String
  agentName    String?
  expiresAt    DateTime

  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([code, type])
  @@index([expiresAt])
  @@index([connectionId])
  @@index([agentId])
  @@map("slack_verification_codes")
}

// ============================================================================
// Microsoft Teams mappings + verification codes — deliberate mirror of the
// Slack models rather than a generalized "channel mapping" table. The one
// structural difference: Teams proactive sends are addressed by a stored
// conversation id, so both mapping kinds persist one.
// ============================================================================

model TeamsMapping {
  id           String @id @default(uuid())
  connectionId String
  agentId      String
  tenantId     String?

  // Personal (DM) mapping: the Teams user (AAD object id when present, else
  // the Bot Framework id) linked to a Lens user, plus the personal-scope
  // conversation id — the target every proactive DM send is addressed to.
  teamsUserId      String?
  lensUserId       String?
  dmConversationId String?

  // Team mode: a linked channel. The conversation id is stored WITHOUT any
  // ";messageid=" thread suffix so lookups and broadcast targeting stay stable.
  channelConversationId String? @unique
  channelName           String?

  // Team mode: the agent's "main" channel — where heartbeat alerts (and
  // scheduled tasks with no resolvable origin channel) are posted. At most one
  // channel mapping per agent is flagged; delivery falls back to the oldest
  // linked channel when none is flagged (see teamsMappingService.getMainChannel).
  isMainChannel Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([connectionId, teamsUserId])
  @@index([connectionId])
  @@index([lensUserId])
  @@index([agentId])
  @@map("teams_mappings")
}

enum TeamsVerificationType {
  DM
  CHANNEL
}

model TeamsVerificationCode {
  id           String                @id @default(uuid())
  code         String
  type         TeamsVerificationType
  lensUserId   String
  connectionId String
  agentId      String
  agentName    String?
  expiresAt    DateTime

  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([code, type])
  @@index([expiresAt])
  @@index([connectionId])
  @@index([agentId])
  @@map("teams_verification_codes")
}

model AgentSubagent {
  id            String @id @default(uuid())
  parentAgentId String
  childAgentId  String
  description   String @default("")

  parentAgentWorkspace AgentWorkspace @relation("ParentAgent", fields: [parentAgentId], references: [id], onDelete: Cascade)
  childAgentWorkspace  AgentWorkspace @relation("ChildAgent", fields: [childAgentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([parentAgentId, childAgentId])
  @@index([parentAgentId])
  @@index([childAgentId])
  @@map("agent_subagents")
}

model SlackHeartbeatTrigger {
  id               String    @id @default(uuid())
  connectionId     String
  slackChannelId   String    @unique
  slackChannelName String?
  agentId          String    @unique
  userId           String
  isActive         Boolean   @default(true)
  throttleSeconds  Int       @default(60) @map("throttle_seconds")
  lastTriggeredAt  DateTime? @map("last_triggered_at")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([userId])
  @@map("slack_heartbeat_triggers")
}

model PendingSlackMessage {
  id        String   @id @default(uuid())
  agentId   String
  sender    String
  text      String
  timestamp String
  createdAt DateTime @default(now())

  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@map("pending_slack_messages")
}

// ============================================================================
// Webhook Subscriptions
// ============================================================================
//
// Named inbound webhook routes (POST /agents/webhooks/:name). Modeled on
// hermes-agent's webhook subscriptions: an optional event-type allowlist
// (matched against X-GitHub-Event / X-GitLab-Event / payload `event_type`),
// an optional prompt template ({dot.path} / {__raw__} substitution; empty =
// raw payload dump), and a delivery target. `deliverOnly` skips the agent and
// delivers the rendered template directly (no LLM).
//
// Sender authentication is generic and provider-agnostic (see
// src/lib/webhook-signature.ts): `authType` picks the scheme ('none' | 'token'
// | 'hmac'), `authHeader` names the header that carries the credential,
// `authPrefix` is an optional literal stripped from that value ('sha256=',
// 'Bearer', …), and `authAlgorithm`/`authEncoding` shape the HMAC digest.
// Every real sender is a configuration recipe, not a code path. The secret is
// stored plaintext (single-agent mode has no key material) and is never
// returned by the management API.

model WebhookSubscription {
  id          String  @id @default(uuid())
  agentId     String
  name        String  @unique
  description String?
  events      String? // comma-separated allowlist; null/empty = all events
  prompt      String? // template; null/empty = raw payload dump
  deliverTo   String  @default("all") // 'all' | 'chat' | 'slack'
  deliverOnly Boolean @default(false)
  isActive    Boolean @default(true)

  authType      String  @default("none") // 'none' | 'token' | 'hmac'
  authHeader    String? // header carrying the token/signature
  authPrefix    String? // literal stripped before comparing (e.g. 'sha256=')
  authAlgorithm String  @default("sha256") // hmac only: sha256 | sha1 | sha512
  authEncoding  String  @default("hex") // hmac only: hex | base64
  secret        String? // shared token / HMAC key; never leaves the process

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("webhook_subscriptions")
}

// ============================================================================
// Updates
// ============================================================================
//
// One row per self-update attempt of a standalone (SEA) install. A row is
// written PENDING before the process hands off to the new version; the next
// boot resolves it — SUCCESS when the running version matches versionTo,
// FAILURE otherwise. An attempt that fails before the handoff is resolved in
// place. Install-level, not agent-level, so there is no AgentWorkspace
// relation.

enum UpdateTrigger {
  AUTO
  MANUAL
}

enum UpdateOutcome {
  PENDING
  SUCCESS
  FAILURE
}

model UpdateAttempt {
  id          String        @id @default(uuid())
  versionFrom String
  versionTo   String
  trigger     UpdateTrigger
  outcome     UpdateOutcome @default(PENDING)
  errorCode   String? // download_failed | asset_not_found | verify_failed | swap_failed | spawn_failed | restart_version_mismatch
  errorDetail String?
  startedAt   DateTime      @default(now())
  finishedAt  DateTime?

  @@index([startedAt])
  @@map("update_attempts")
}

/// Deployment state, keyed by name: what this install was doing last time,
/// rather than anything about the agent. One key today,
/// `lastExecutionEnvironment`, holding `local` or `docker`.
///
/// It exists to make the storage migration run once per change of environment.
/// That migration copies only what the destination lacks, so repeating it would
/// overwrite nothing — except that a file deleted on one side is still on the
/// other, and a repeat copies it back. Recording where the last run happened is
/// what keeps a deletion deleted.
///
/// A table rather than a column on `AgentWorkspace`, because `index.ts` reads
/// it about ninety lines before `resolveOrBootstrapSingleAgent` creates the row
/// a column would sit on.
model RuntimeState {
  /// What the value is about, e.g. `lastExecutionEnvironment`.
  key       String   @id
  /// The value itself, e.g. `docker`.
  value     String
  updatedAt DateTime @updatedAt

  @@map("runtime_state")
}
