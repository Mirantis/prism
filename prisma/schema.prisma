// Prisma schema for Lens Platform - Personal Agent (Prism) Architecture
// One AI agent per user with persistent identity, memory, and proactive behavior

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum AgentStatus {
  IDLE
  RUNNING
}

enum AgentHeartbeatStatus {
  ENABLED
  STOPPED
}

enum ThreadStatus {
  ACTIVE
  NON_ACTIVE
}

enum MessageRole {
  USER
  AGENT
  SYSTEM
}

enum MessageTrigger {
  USER_INPUT
  HEARTBEAT
  CRON_TASK
  SYSTEM
}

enum ThreadSource {
  DATABASE
  SLACK
}

enum AgentType {
  AGENT
  SUBAGENT
}

// ============================================================================
// Agent Workspace - Scoped to Nexus Org/Team
// ============================================================================

model AgentWorkspace {
  id        String    @id @default(uuid())
  userId    String // Creator / owner user ID
  name      String    @default("Prism Agent")
  agentType AgentType @default(AGENT)

  // Workspace files (markdown documents always loaded into context)
  soulMd      String @db.Text // Agent constitution (user-editable, agent informs of changes)
  userMd      String @db.Text // User profile (user-editable via tools)
  memoryMd    String @db.Text // Curated knowledge (agent-editable via tools)
  heartbeatMd String @db.Text // Heartbeat instructions (user-editable)
  visionMd    String @default("") @db.Text // User's vision/goals for the agent to advance
  agentMd     String @default("") @db.Text // Agent operating manual (user-editable)

  // Bootstrap (one-time onboarding, cleared when done)
  bootstrapMd String @db.Text // First-run onboarding (cleared when complete)

  // Behavioral settings (can be adjusted via chat)
  heartbeatIntervalMs Int                  @default(28800000) // 8 hours
  heartbeatStatus     AgentHeartbeatStatus @default(ENABLED) // Heartbeat loop enabled/disabled
  proactivity         Int                  @default(3) // 1-5 scale
  verbosity           Int                  @default(3) // 1-5 scale
  timezone            String               @default("UTC")
  model               String? // Per-agent LLM model override; null falls back to BEDROCK_MODEL_ID

  // Session settings
  dailyResetHour  Int  @default(4) // 4 AM local time
  idleTimeoutMins Int? // Optional idle timeout

  // Nexus MCP Server authentication (agent token for machine identity)
  // Created during bootstrap or via MCP Admin UI, stored here encrypted for agent to use
  nexusMcpAgentToken   String? @db.Text
  nexusAgentTokenId    String? // Nexus-assigned UUID for the agent token (used for spending limits)

  // Status
  status           AgentStatus @default(IDLE)
  lastHeartbeat    DateTime?
  currentSessionId String? // Active session reference

  // Relations
  threads                ConversationThread[]
  cronTasks              CronTask[]
  memoryEntries          MemoryEntry[]
  slackMappings          SlackMapping[]
  slackVerificationCodes SlackVerificationCode[]
  slackHeartbeatTriggers SlackHeartbeatTrigger[]
  pendingSlackMessages   PendingSlackMessage[]
  subagentLinks          AgentSubagent[]         @relation("ParentAgent")
  parentAgentLinks       AgentSubagent[]         @relation("ChildAgent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("agent_workspaces")
}

// ============================================================================
// Conversations - Chat threads with messages
// ============================================================================

model ConversationThread {
  id      String       @id @default(uuid())
  agentId String
  userId  String
  title   String? // Auto-generated or user-provided
  status  ThreadStatus @default(ACTIVE)

  // External thread binding (e.g. Slack thread_ts)
  // Binds this thread to a specific external conversation thread
  externalThreadId String?

  // Thread source — determines which provider reads messages
  threadSource      ThreadSource @default(DATABASE)
  // Slack channel ID (C...) — needed for conversations.replies which requires channel + ts
  externalChannelId String?

  // Compaction support for long conversations
  compactionSummary String?   @db.Text // Summary of older messages
  compactedAt       DateTime?

  messages ConversationMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentWorkspace AgentWorkspace              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  participants   ConversationParticipant[]

  @@unique([agentId, userId, externalThreadId])
  @@map("conversation_threads")
}

model ConversationMessage {
  id          String         @id @default(uuid())
  threadId    String
  role        MessageRole // USER, AGENT, SYSTEM
  content     String         @db.Text
  triggeredBy MessageTrigger // USER_INPUT, HEARTBEAT, CRON_TASK, SYSTEM
  toolCalls   Json? // Array of tool call records
  blocks      Json? // UI blocks for rich rendering
  tokenCount  Int? // For context window tracking

  // Multi-user context (for channel messages)
  senderExternalId  String? // External user ID (Slack: U..., Discord: snowflake, etc.)
  senderName        String? // Human-readable display name
  externalMessageId String? // Channel-specific message ID (e.g. Slack ts) for matching DB records to external messages

  // Compaction flag
  isCompacted Boolean @default(false)

  createdAt DateTime @default(now())

  thread ConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@map("conversation_messages")
}

// Track multiple participants in channel conversations
model ConversationParticipant {
  id             String   @id @default(uuid())
  threadId       String // References ConversationThread
  externalUserId String // External user ID (Slack: U..., Discord: snowflake, etc.)
  displayName    String? // Human-readable name
  channel        String // Channel type: 'slack' etc.
  joinedAt       DateTime @default(now())

  thread ConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, externalUserId, channel])
  @@map("conversation_participants")
}

// ============================================================================
// Cron Tasks - User-scheduled tasks
// ============================================================================

model CronTask {
  id      String @id @default(uuid())
  agentId String
  userId  String

  name        String // "Daily security scan"
  schedule    String // Cron expression: "0 9 * * *"
  instruction String @db.Text // What to do

  isActive  Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("cron_tasks")
}

// ============================================================================
// Memory System - Simplified flat table (agent-curated)
// ============================================================================

model MemoryEntry {
  id         String                       @id @default(uuid())
  agentId    String
  content    String                       @db.Text
  category   String // "observation", "action", "decision", "event"
  importance Int                          @default(5) // 1-10 for search ranking
  embedding  Unsupported("vector(1024)")?
  createdAt  DateTime                     @default(now())

  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([agentId, category])
  @@map("memory_entries")
}

// ============================================================================
// Slack Integration - Channel Connections
// ============================================================================

// NOTE: SlackConnection data lives exclusively in the backend-only database
// (backendPrisma / lens_agents_backend). Agent-runtime accesses it via
// /internal/api/slack-connections HTTP endpoints, not via Prisma.

// Maps Slack users/channels to Lens Platform agents
// EITHER user mapping (personal/DM mode) OR channel mapping (team mode)
model SlackMapping {
  id           String @id @default(uuid())
  connectionId String // Which Slack connection
  agentId      String // Which agent this mapping routes to

  // EITHER user mapping (personal/DM mode)...
  slackUserId String? // Slack user ID (U...)
  lensUserId  String? // Lens Platform user ID
  dmChannelId String? // Slack DM channel ID (D...)

  // ...OR channel mapping (team mode)
  slackChannelId   String? @unique // Slack channel ID (C...)
  slackChannelName String? // Channel display name

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations (connectionId is a plain string — SlackConnection lives in the backend-only DB)
  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([connectionId, slackUserId])
  @@index([connectionId])
  @@index([lensUserId])
  @@index([agentId])
  @@map("slack_mappings")
}

// ============================================================================
// Slack Verification Codes — DB-backed (replaces in-memory Maps)
// ============================================================================

enum SlackVerificationType {
  DM // Personal mode — user links their Slack DM
  CHANNEL // Team mode — user links a Slack channel
}

model SlackVerificationCode {
  id           String                @id @default(uuid())
  code         String // 6-char hex code (uppercase)
  type         SlackVerificationType // DM or CHANNEL
  lensUserId   String // Lens user who requested linking
  connectionId String // SlackConnection this links through
  agentId      String // Target agent
  agentName    String? // Agent name (only for CHANNEL type)
  expiresAt    DateTime // 15 minutes from creation

  // Relations (connectionId is a plain string — SlackConnection lives in the backend-only DB)
  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([code, type])
  @@index([expiresAt])
  @@index([connectionId])
  @@index([agentId])
  @@map("slack_verification_codes")
}

// ============================================================================
// Agent Subagents - Parent-child relationships between agents
// ============================================================================

model AgentSubagent {
  id            String @id @default(uuid())
  parentAgentId String
  childAgentId  String
  description   String @default("")

  parentAgentWorkspace AgentWorkspace @relation("ParentAgent", fields: [parentAgentId], references: [id], onDelete: Cascade)
  childAgentWorkspace  AgentWorkspace @relation("ChildAgent", fields: [childAgentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([parentAgentId, childAgentId])
  @@index([parentAgentId])
  @@index([childAgentId])
  @@map("agent_subagents")
}

// ============================================================================
// Slack Heartbeat Trigger - Event-driven heartbeat from Slack channel messages
// ============================================================================

model SlackHeartbeatTrigger {
  id               String    @id @default(uuid())
  connectionId     String
  slackChannelId   String    @unique
  slackChannelName String?
  agentId          String    @unique
  userId           String
  isActive         Boolean   @default(true)
  throttleSeconds  Int       @default(60) @map("throttle_seconds")
  lastTriggeredAt  DateTime? @map("last_triggered_at")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations (connectionId is a plain string — SlackConnection lives in the backend-only DB)
  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([userId])
  @@map("slack_heartbeat_triggers")
}

// ============================================================================
// Pending Slack Messages - Queue for heartbeat trigger messages
// ============================================================================

model PendingSlackMessage {
  id        String   @id @default(uuid())
  agentId   String
  sender    String
  text      String   @db.Text
  timestamp String // ISO-8601 timestamp from Slack message
  createdAt DateTime @default(now())

  agentWorkspace AgentWorkspace @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@map("pending_slack_messages")
}
