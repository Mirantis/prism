# Agent Runtime Environment Variables

# Server
PORT=3003

# LLM provider selection: `bedrock` (default), `azure`, `bedrock-mantle`, or
# `openai`. One provider per container. Leave unset for Bedrock.
# LLM_PROVIDER=bedrock

# AWS Bedrock Configuration (for LLM invocation; used when LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
BEDROCK_MODEL_ID=global.anthropic.claude-opus-5
# BEDROCK_CLASSIFICATION_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional fast-model policy gate for sensitive tool calls:
#   off     — no evaluation (default; preserves existing behavior)
#   observe — evaluate and emit telemetry, but never block
#   enforce — block rejected calls; evaluator failures fail closed; run Claude
#             Code edit tasks in auto permission mode instead of bypass mode
TOOL_RISK_GATE_MODE=off

# Context window (input tokens) to assume for the "% context left" indicator in
# the web and terminal UIs. Normally derived from the model ID via the models.dev
# catalog; set this only for a model that catalog doesn't know — most often a
# custom Azure Foundry deployment name. Ignored unless a positive integer.
# CONTEXT_WINDOW_TOKENS=1000000

# Opt in to refreshing the model-window catalog from a registry once at startup.
# Unset (the default) means no outbound call — the bundled catalog is used. The
# bundled catalog always answers either way, so this only adds windows for models
# released since the last build.
# MODELS_DEV_URL=https://models.dev/api.json

# Auto-compact a thread when its context occupancy reaches this percent of the
# model's window (the older history is summarized; the newest messages stay
# verbatim). 0 disables auto-compaction; out-of-range values fall back to 90.
# COMPACTION_THRESHOLD_PERCENT=90

# How many of the newest messages stay out of compaction (kept verbatim).
# COMPACTION_TAIL_MESSAGES=6

# Azure Configuration — Claude via Microsoft Foundry (used when LLM_PROVIDER=azure).
# Chat/classification speak the Anthropic Messages API on the Foundry resource
# (https://{resource}.services.ai.azure.com/anthropic/v1/messages). Model IDs
# are Foundry *deployment names*; the defaults below match Foundry's default
# deployment names. AZURE_API_KEY is sent as the x-api-key header (may be a
# __nexus_cred:<uuid>__ sentinel the proxy rewrites).
# Embeddings use an Azure OpenAI text-embedding-3 deployment on the same
# resource (truncated to 1024 dims for the memory index). Defaults to
# text-embedding-3-small; that deployment must exist on the resource, else
# memory embedding fails open (no vector). Set AZURE_EMBEDDING_MODEL_ID='' to
# skip embeddings entirely.
# AZURE_RESOURCE_NAME=your-foundry-resource
# AZURE_API_KEY=your-azure-api-key
# AZURE_MODEL_ID=claude-opus-5                      # chat deployment (default)
# AZURE_CLASSIFICATION_MODEL_ID=claude-haiku-4-5    # fast deployment (default)
# AZURE_EMBEDDING_MODEL_ID=text-embedding-3-small   # embedding deployment (default)
# AZURE_API_VERSION=                   # embeddings only; SDK default is 'preview'
# AZURE_FOUNDRY_BASE_URL=              # override the derived .../anthropic/v1 chat endpoint

# Bedrock Mantle — AWS's second Bedrock inference endpoint, at
# https://bedrock-mantle.{region}.api.aws/anthropic/v1/messages (used when
# LLM_PROVIDER=bedrock-mantle). Auth is the same AWS_BEARER_TOKEN_BEDROCK key as
# native Bedrock, sent here as the x-api-key header; it is REQUIRED for direct
# mode (mantle's Anthropic surface has no SigV4 path) and unnecessary through
# the Lens Agents gateway. AWS_REGION selects the host.
# Model IDs are *bare* Bedrock IDs — mantle has no cross-region inference
# profiles, so `us.anthropic.…` is rejected. The chat and classification vars
# therefore deliberately do not fall back to the BEDROCK_* vars above, which
# carry that prefix. A prefix on a per-agent override is stripped automatically
# at request time.
# Mantle serves no embedding models, so memory embeddings stay on Titan over
# bedrock-runtime — that leg is unaffected by the prefix rule, so the embedding
# var DOES inherit BEDROCK_EMBEDDING_MODEL_ID. Set
# BEDROCK_MANTLE_EMBEDDING_MODEL_ID='' to skip embeddings.
# BEDROCK_MANTLE_MODEL_ID=anthropic.claude-opus-5                             # chat (default)
# BEDROCK_MANTLE_CLASSIFICATION_MODEL_ID=anthropic.claude-haiku-4-5              # fast (default)
# BEDROCK_MANTLE_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0              # Titan, via bedrock-runtime
# BEDROCK_MANTLE_BASE_URL=             # override the derived .../anthropic/v1 chat endpoint

# OpenAI Configuration — the official OpenAI API (used when LLM_PROVIDER=openai).
# The one vendor not serving Claude: chat/classification speak the Responses
# API and embeddings ride the same surface, all authenticated with the SAME
# OPENAI_API_KEY the voice-meetings block below uses (setting it for chat also
# enables the meeting tools where the browser/audio toolchain is present). The
# key rides only a bearer header, so it may be a __nexus_cred:<uuid>__ sentinel;
# through the Lens Agents gateway (`…/llm/openai/v1`) no local key is needed at
# all — only the Realtime WebSocket below stays off the gateway.
# The classification model runs the DELIVER/SUPPRESS gates with reasoning
# pinned off (reasoningEffort 'none') and no temperature param — GPT-5.x
# models reject or strip an explicit temperature, and reasoning tokens would
# eat the gates' tiny token budgets.
# Embeddings are truncated to 1024 dims for the memory index; set
# OPENAI_EMBEDDING_MODEL_ID='' to skip embeddings entirely.
# OPENAI_MODEL_ID=gpt-5.6-sol                       # chat (default)
# OPENAI_CLASSIFICATION_MODEL_ID=gpt-5.6-luna       # fast (default)
# OPENAI_EMBEDDING_MODEL_ID=text-embedding-3-small  # embeddings (default)
# OPENAI_BASE_URL=                     # override the direct endpoint; must serve /responses

# Lens Agents base URL (LLM proxy, classification routing)
NEXUS_API_URL=http://localhost:3002

# Lens Agents MCP endpoint URL. In the Lens Agents sandbox this is injected
# automatically (project-scoped /projects/:id/mcp). For local dev, set it
# explicitly to get those MCP tools — there is no NEXUS_API_URL fallback.
# NEXUS_MCP_URL=http://localhost:3002/mcp

# Database — for local dev/Prisma CLI, file:./agent.db resolves to prisma/sqlite/agent.db.
# In Docker, start.sh defaults DATABASE_URL to file:/data/agent.db for the mounted /data volume.
DATABASE_URL=file:./agent.db

# Working directory for the agent's shell tools (shell_exec, shell_write_file, …).
# Defaults to /home/node (which exists in the container). Outside the container
# that path can't be created (e.g. macOS `npm run dev`), so the runtime falls
# back to a temp dir and logs a warning — set this to a writable path to pick
# your own and silence it.
# SHELL_WORKSPACE_ROOT=/tmp/prism-workspace

# Slack App Credentials (for Slack integration)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_APP_TOKEN=your-slack-app-level-token

# OpenTelemetry (optional — disabled when not set)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_API_KEY=  # only set when pointing at the third-party collector
# Identifies the deployment on OTel records (production | staging | development).
# Defaults to development when unset.
# DEPLOYMENT_ENVIRONMENT=development
# Build identifier emitted as the OTel `service.version` resource attribute.
# Baked into published images by the release workflows (release tag for
# release-production.yml, `canary-<sha>` for release-canary.yml). Leave unset
# locally — the attribute is omitted from the resource entirely when empty.
# SERVICE_VERSION=

# ----------------------------------------------------------------------------
# Voice meetings (optional — see docs/voice-meetings.md)
# ----------------------------------------------------------------------------
# Lets the agent join a Google Meet call and take part by voice. Needs the
# browser/audio toolchain, which only ships in the container image — locally the
# meeting tools stay unregistered even with a key set.
#
# The Realtime API is the one model call that never goes through the Lens
# Agents gateway (its openai mount routes POST only, and no managed-inference backend
# serves a realtime voice surface), so this connects straight to api.openai.com.
# The key is shared with the OpenAI chat provider above — one OPENAI_API_KEY
# serves both.
# OPENAI_API_KEY=sk-...
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1  # pinned snapshot; gpt-realtime-mini is cheaper
# OPENAI_REALTIME_VOICE=marin           # marin is notably better than the API default
# How hard the in-meeting model thinks before answering or picking a tool:
# minimal | low | medium | high | xhigh. The API's own default is low; this
# defaults to high because the model in a call holds the agent's real tools.
# Higher levels cost latency, which in a call is silence. Empty = let the API pick.
# OPENAI_REALTIME_REASONING_EFFORT=high
# OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe  # only used when MEETING_TRANSCRIPT_LOGGING=full
# OPENAI_NOISE_REDUCTION=off                   # off | near_field | far_field; off is the default —
#                                              # Meet already cleans this audio, and reducing it twice
#                                              # suppresses quiet speakers the agent then never hears
#
# Whether what is said in a call may reach the log: off | full.
# off  — verdict, utterance id, mode and the *number* of names seeded to the
#        transcriber; no words, no attendee names. The default: a call is not an
#        authenticated surface and the room did not agree to be written down.
# full — adds the sentence, the roster and the gate model's own reasoning. Turn on
#        to diagnose "it stopped answering to its name", with the room's agreement,
#        and turn it back off afterwards.
# MEETING_TRANSCRIPT_LOGGING=off
# Google account the agent joins meetings as. Effectively required: Google
# auto-denies automated anonymous guests (the host is never even asked). Use a
# dedicated account; the browser profile is persisted so sign-in happens once.
#
# The password must be the REAL password in plain text — a credential sentinel does
# not work here. Sentinels are swapped in on the wire and only work for a secret sent
# as a header; this one is typed into Google's sign-in form, so the runtime holds the
# actual value. Meet has no bot API, so this is the trade-off for joining at all.
# GOOGLE_BOT_EMAIL=
# GOOGLE_BOT_PASSWORD=
# MEETING_TIMEOUT_MINUTES=60            # hard cap on one call
# MEETING_ADMISSION_TIMEOUT_SECONDS=300 # how long to wait to be admitted

# ----------------------------------------------------------------------------
# Optional local-dev overrides
# ----------------------------------------------------------------------------
# AGENT_ID=                            # leave empty to auto-bootstrap a fresh UUID
# AWS_BEARER_TOKEN_BEDROCK=            # for LLM calls (or rely on AWS_ACCESS_KEY_ID/SECRET above;
#                                      # required, no key/secret alternative, on bedrock-mantle)
# SLACK_BOT_TOKEN=xoxb-...             # real bot token (enables the Slack adapter)
# SLACK_APP_TOKEN=xapp-...             # real app token (Socket Mode)
