# Agent Runtime Environment Variables

# Server
PORT=3003

# Auth
INTERNAL_API_SECRET=dev-secret-change-in-production

# AWS Bedrock Configuration (for LLM invocation)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-7

# Backend API
BACKEND_URL=http://localhost:3001
INTERNAL_MCP_URL=http://localhost:3003/internal/mcp

# Nexus base URL (MCP tools, LLM proxy)
NEXUS_URL=http://localhost:3002

# Database
DATABASE_URL=postgresql://lens:lens@localhost:5432/lens_platform

# Token Encryption (for encrypting/decrypting agent tokens and Slack bot tokens)
# Must match backend's ENCRYPTION_KEY
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-encryption-key

# Slack App Credentials (for Slack integration)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_APP_TOKEN=your-slack-app-level-token

# OpenTelemetry (optional — disabled when not set)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_API_KEY=  # only set when pointing at the third-party collector
# Identifies the deployment on OTel records (production | staging | development).
# Defaults to development when unset.
# DEPLOYMENT_ENVIRONMENT=development

# ----------------------------------------------------------------------------
# Single-agent mode (local dev — `npm run dev:single` from agent-runtime/)
# ----------------------------------------------------------------------------
# Uncomment the lines below to run the agent runtime locally on host (no
# Docker, no Nexus sandbox) — embedded SQLite, no backend dependency, fast
# tsx-watch restart on any TypeScript change. Pairs with `npm run dev:web` /
# `dev:single` for UI work, but works on its own for any agent-runtime
# development: services, MCP tools, prompts, conversation engine, heartbeats,
# cron, Slack adapter, WS gateway. Documented in CLAUDE.md → "Local development".
#
# Boot behavior:
#   - DATABASE_URL defaults to file:/data/agent.db (set the override below to
#     point at a host-writable path)
#   - WS gateway trusts the connection (no JWT required; Nexus inbound routing
#     handles auth in prod, nothing in front for local dev)
#   - Static SPA from web/dist served at `/` when SPA bundle exists
#
# Credentials below are optional. The runtime fails open: Slack adapter
# disables itself when SLACK_BOT_TOKEN is unset; Bedrock falls back to the
# SDK credential-provider chain (~/.aws/credentials, aws sso, etc.).
# Supply real values if you want chat / Slack to function end-to-end —
# these must be real tokens, NOT Nexus credential sentinels
# (`__nexus_cred:...__`), since there's no MITM proxy on host to rewrite them.

# DATABASE_URL=file:./agent-local.db
# AGENT_ID=                            # leave empty to auto-bootstrap a fresh UUID
# AWS_BEARER_TOKEN_BEDROCK=            # for LLM calls (or rely on AWS_ACCESS_KEY_ID/SECRET above)
# SLACK_BOT_TOKEN=xoxb-...             # real bot token
# SLACK_APP_TOKEN=xapp-...             # real app token (Socket Mode)
