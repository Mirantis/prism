# Dependencies are installed inside the image; a checkout's copies (or a worktree's
# symlinks to them) must not ride along in the build context.
node_modules
**/node_modules

# Build outputs the image produces itself.
dist
web/dist
cli/dist

# Never in an image.
.env
.env.*
!.env.example

# Not needed to build, and large.
.git
.claude
e2e/test-results
e2e/playwright-report
