{
  "name": "prism-agent",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "workspaces": [
    "web",
    "cli",
    "e2e"
  ],
  "scripts": {
    "db:migrate": "prisma migrate dev --schema=prisma/sqlite/schema.prisma",
    "predev": "prisma migrate deploy --schema=prisma/sqlite/schema.prisma && prisma generate --schema=prisma/sqlite/schema.prisma",
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm --workspace=prism-agent-web run dev",
    "dev:tui": "npm --workspace=prism-cli run dev",
    "dev:single": "tsx src/scripts/apply-pending-import.ts && prisma migrate deploy --schema=prisma/sqlite/schema.prisma && concurrently --kill-others-on-exit --prefix \"[{name}]\" --names \"runtime,web\" --prefix-colors \"cyan,green\" \"npm run dev\" \"npm run dev:web\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc && npm run build:web",
    "build:web": "npm --workspace=prism-agent-web run build",
    "build:binaries": "bash scripts/build-binaries.sh",
    "worktree": "bash scripts/create-worktree.sh",
    "cleanup:local": "bash cleanup-local-prism.sh",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "docker:build": "bash scripts/docker-build.sh",
    "docker:start": "bash scripts/docker-start.sh",
    "docker:run": "docker run -it -p 3003:3003 -v prism-data:/data -e AWS_BEARER_TOKEN_BEDROCK --entrypoint /bin/sh prism-agent:local -c './start.sh > /dev/null 2>&1 & exec prism'",
    "docker:dev": "bash scripts/docker-dev.sh",
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "prisma generate --schema=prisma/sqlite/schema.prisma",
    "generate:model-limits": "tsx src/scripts/generate-model-limits.ts",
    "eval:prompts": "tsx src/evals/run.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.113",
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/azure": "^4.0.99",
    "@ai-sdk/mcp": "^2.0.73",
    "@ai-sdk/openai": "^4.0.99",
    "@ai-sdk/otel": "^1.0.137",
    "@aws-sdk/credential-provider-node": "^3.972.85",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@langfuse/otel": "^5.13.1",
    "@microsoft/teams.api": "^2.1.0",
    "@microsoft/teams.apps": "^2.1.0",
    "@mixmark-io/domino": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@slack/bolt": "^5.1.0",
    "ai": "^7.0.137",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "linkedom": "^0.18.13",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "playwright-core": "^1.64.0",
    "prisma": "^7.10.0",
    "quickjs-emscripten-core": "0.32.0",
    "sqlite-vec": "^0.1.9",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^7.29.1",
    "uuid": "^14.0.3",
    "ws": "^8.22.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.23.3",
    "oxlint": "^1.87.0",
    "postject": "^1.0.0-alpha.6",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "katex": "^0.18.2",
    "mysql2": "^3.24.5",
    "smol-toml": "^1.9.1",
    "@prisma/adapter-better-sqlite3": {
      "better-sqlite3": "$better-sqlite3"
    },
    "@microsoft/teams.apps": {
      "@azure/msal-node": "^7.1.0"
    },
    "@ts-morph/common": {
      "minimatch": "^11.0.1"
    },
    "markdown-it": "^15.0.3"
  }
}
