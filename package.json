{
  "name": "prism-agent",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "workspaces": [
    "web",
    "cli",
    "e2e"
  ],
  "scripts": {
    "db:migrate": "prisma migrate dev",
    "predev": "prisma migrate deploy --schema=prisma/sqlite/schema.prisma",
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm --workspace=prism-agent-web run dev",
    "dev:tui": "npm --workspace=prism-cli run dev",
    "dev:single": "tsx src/scripts/apply-pending-import.ts && prisma migrate deploy --schema=prisma/sqlite/schema.prisma && concurrently --kill-others-on-exit --prefix \"[{name}]\" --names \"runtime,web\" --prefix-colors \"cyan,green\" \"npm run dev\" \"npm run dev:web\"",
    "build": "tsc && npm run build:web",
    "build:web": "npm --workspace=prism-agent-web run build",
    "build:binaries": "bash scripts/build-binaries.sh",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "docker:build": "printf '@lensapp:registry=https://npm.pkg.github.com/\\n//npm.pkg.github.com/:_authToken=%s\\n' \"$NODE_AUTH_TOKEN\" > .npmrc-secret && docker build --load --secret id=npmrc,src=.npmrc-secret -t prism-agent:local -f Dockerfile . ; rm -f .npmrc-secret",
    "docker:run": "docker run -it -p 3003:3003 -v prism-data:/data -e AWS_BEARER_TOKEN_BEDROCK --entrypoint /bin/sh prism-agent:local -c './start.sh > /dev/null 2>&1 & exec prism'",
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "prisma generate --schema=prisma/sqlite/schema.prisma",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.77",
    "@ai-sdk/mcp": "^1.0.25",
    "@aws-sdk/credential-provider-node": "^3.972.17",
    "@langfuse/otel": "^4.6.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@opentelemetry/api-logs": "^0.213.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-logs": "^0.213.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@prisma/client": "^6.19.2",
    "@slack/bolt": "^4.6.0",
    "ai": "^6.0.116",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.2",
    "sqlite-vec": "^0.1.9",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.12.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.21.0",
    "oxlint": "^1.51.0",
    "postject": "^1.0.0-alpha.6",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
