{
  "name": "prism-agent",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "workspaces": [
    "web",
    "cli",
    "e2e"
  ],
  "scripts": {
    "db:migrate": "prisma migrate dev --schema=prisma/sqlite/schema.prisma",
    "predev": "prisma migrate deploy --schema=prisma/sqlite/schema.prisma && prisma generate --schema=prisma/sqlite/schema.prisma",
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm --workspace=prism-agent-web run dev",
    "dev:tui": "npm --workspace=prism-cli run dev",
    "dev:single": "tsx src/scripts/apply-pending-import.ts && prisma migrate deploy --schema=prisma/sqlite/schema.prisma && concurrently --kill-others-on-exit --prefix \"[{name}]\" --names \"runtime,web\" --prefix-colors \"cyan,green\" \"npm run dev\" \"npm run dev:web\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc && npm run build:web",
    "build:web": "npm --workspace=prism-agent-web run build",
    "build:binaries": "bash scripts/build-binaries.sh",
    "worktree": "bash scripts/create-worktree.sh",
    "cleanup:local": "bash cleanup-local-prism.sh",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "docker:build": "docker build --load -t prism-agent:local -f Dockerfile .",
    "docker:run": "docker run -it -p 3003:3003 -v prism-data:/data -e AWS_BEARER_TOKEN_BEDROCK --entrypoint /bin/sh prism-agent:local -c './start.sh > /dev/null 2>&1 & exec prism'",
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "prisma generate --schema=prisma/sqlite/schema.prisma",
    "generate:model-limits": "tsx src/scripts/generate-model-limits.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.59",
    "@ai-sdk/anthropic": "^4.0.40",
    "@ai-sdk/azure": "^4.0.45",
    "@ai-sdk/mcp": "^2.0.34",
    "@ai-sdk/openai": "^4.0.44",
    "@ai-sdk/otel": "^1.0.70",
    "@aws-sdk/credential-provider-node": "^3.972.17",
    "@langfuse/otel": "^4.6.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@opentelemetry/api-logs": "^0.217.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.217.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-logs": "^0.217.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@prisma/client": "^6.19.2",
    "@slack/bolt": "^4.6.0",
    "ai": "^7.0.70",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright-core": "^1.62.1",
    "prisma": "^6.19.2",
    "sqlite-vec": "^0.1.9",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.12.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.21.0",
    "oxlint": "^1.51.0",
    "postject": "^1.0.0-alpha.6",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "vite": "7.3.5",
    "dompurify": "^3.4.13",
    "undici": "^7.29.0",
    "hono": "^4.12.34",
    "protobufjs": "^7.6.5",
    "markdown-it": "^14.2.0",
    "shell-quote": "^1.9.0",
    "esbuild": "$esbuild",
    "js-yaml": "^4.3.1",
    "@babel/core": "^7.29.6",
    "@opentelemetry/core": "^2.8.0",
    "@hono/node-server": "^1.19.15",
    "@opentelemetry/propagator-jaeger": "^2.9.0",
    "axios": "^1.18.0",
    "body-parser": "^2.3.0",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "ip-address": "^10.3.1",
    "linkify-it": "^5.0.2",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "@cucumber/messages": {
      "uuid": "^11.1.1"
    }
  }
}
