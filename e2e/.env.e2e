# E2E Test Environment Variables

# === Agent Runtime ===
# DATABASE_URL is pinned by global-setup.ts to file:./e2e.db (resolved
# relative to prisma/sqlite/) so the runtime and the test process open
# the same SQLite file. Anything set here would be overwritten.
PORT=3003
AGENT_RUNTIME_URL=http://localhost:3003
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# === Telemetry ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# AWS credentials — set in your shell or CI environment
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# === Slack ===
# Slack is disabled by default. To run @slack e2e tests, create .env.e2e.local
# (gitignored) with real credentials. See .env.e2e.local.example for the list.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_APP_TOKEN=
