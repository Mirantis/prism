# Copy this file to .env.e2e.local and fill in real values.
# .env.e2e.local is gitignored and overrides .env.e2e.

# Slack App Credentials (needed by agent-runtime for Socket Mode)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_APP_TOKEN=xapp-...

# Slack E2E test credentials
SLACK_E2E_BOT_TOKEN=xoxb-...
SLACK_E2E_USER_TOKEN=xoxp-...
SLACK_E2E_BOT_USER_ID=U...
SLACK_E2E_TEAM_ID=T...
SLACK_E2E_TEAM_NAME=MyWorkspace
# App ID (A...) of the same test Slack app. Found on the app's Basic Information
# page. Forwarded to the backend as SLACK_EXPECTED_APP_ID so the configure-Slack
# flow accepts the bot token above.
SLACK_E2E_EXPECTED_APP_ID=A...

# Microsoft Teams E2E test credentials (@teams suite; skips when unset).
# Needs a dedicated M365 test tenant with the bot app sideloaded, plus the
# Azure Bot's messaging endpoint pointing at the e2e runtime through a
# path-restricting proxy + tunnel that exposes ONLY POST /agents/teams/messages
# (see e2e/README.md — never tunnel the whole runtime port).
# Runtime credentials (forwarded as TEAMS_APP_ID / TEAMS_APP_PASSWORD /
# TEAMS_APP_TENANT_ID):
TEAMS_E2E_APP_ID=
TEAMS_E2E_APP_PASSWORD=
TEAMS_E2E_TENANT_ID=
# Graph access as the human test user (delegated token; scopes:
# ChannelMessage.Send, ChannelMessage.Read.All, Chat.ReadWrite):
TEAMS_E2E_USER_TOKEN=
# Pre-provisioned targets:
TEAMS_E2E_TEAM_ID=
TEAMS_E2E_CHANNEL_ID=19:...@thread.tacv2
TEAMS_E2E_CHAT_ID=
# The bot as it appears in Teams (for @mention entities):
TEAMS_E2E_BOT_APP_ID=
TEAMS_E2E_BOT_NAME=
