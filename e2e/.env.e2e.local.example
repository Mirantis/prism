# Copy this file to .env.e2e.local and fill in real values.
# .env.e2e.local is gitignored and overrides .env.e2e.

# Slack App Credentials (needed by agent-runtime for Socket Mode)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_APP_TOKEN=xapp-...

# Slack E2E test credentials
SLACK_E2E_BOT_TOKEN=xoxb-...
SLACK_E2E_USER_TOKEN=xoxp-...
SLACK_E2E_BOT_USER_ID=U...
SLACK_E2E_TEAM_ID=T...
SLACK_E2E_TEAM_NAME=MyWorkspace
# App ID (A...) of the same test Slack app. Found on the app's Basic Information
# page. Forwarded to the backend as SLACK_EXPECTED_APP_ID so the configure-Slack
# flow accepts the bot token above.
SLACK_E2E_EXPECTED_APP_ID=A...
