{
  "name": "prism-agent-e2e",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "echo 'No build step for e2e tests'",
    "test": "npx bddgen && npx playwright test",
    "test:headed": "npx bddgen && npx playwright test --headed",
    "test:debug": "npx bddgen && npx playwright test --debug",
    "test:report": "npx playwright show-report",
    "test:e2e:tui": "vitest run -c tui/vitest.config.ts",
    "test:e2e:web": "npx bddgen && npx tsx support/run-web-suite.ts --grep-invert @slack",
    "test:e2e:docker": "npx bddgen && npx playwright test --grep \"Execution environment\"",
    "test:e2e:single-thread": "npx bddgen && npx playwright test --grep @single-thread",
    "test:e2e:no-llm-provider": "npx bddgen && E2E_NO_LLM_PROVIDER=true npx playwright test --grep @no-llm-provider",
    "test:e2e:tool-search": "npx bddgen && npx playwright test --grep @tool-search",
    "test:e2e:slack:web": "npx bddgen && npx playwright test --grep @slack",
    "test:e2e:slack:tui": "vitest run -c tui/vitest.config.ts tui/tests/slack-routed.test.ts tui/tests/bedrock-mantle-slack.test.ts",
    "test:run": "vitest run -c vitest.unit.config.ts"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "2.7.0",
    "@amiceli/vitest-cucumber": "^8.0.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@playwright/test": "^1.64.0",
    "@prisma/client": "^7.10.0",
    "@slack/web-api": "^8.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "agentic-evals": "2.1.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "node-pty": "^1.1.0",
    "playwright-bdd": "^9.2.1",
    "prisma": "^7.10.0",
    "strip-ansi": "^7.2.0",
    "vitest": "^5.0.3"
  },
  "devDependenciesNotes": {
    "@types/express": "provided by root overrides"
  }
}
