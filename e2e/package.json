    "express": "^5.1.0",
    "jose": "^6.0.11",
    "node-pty": "^1.1.0",
    "playwright-bdd": "^8.5.0",
    "prisma": "^6.6.0",
    "strip-ansi": "^7.1.0",
    "vitest": "^4.0.18"
  },
