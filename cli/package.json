{
  "name": "prism-cli",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "prism": "dist/index.js"
  },
  "files": [
    "dist",
    "native/bin",
    "README.md"
  ],
  "scripts": {
    "predev": "node ../scripts/build-cli-audio.mjs",
    "build:audio": "node ../scripts/build-cli-audio.mjs",
    "dev": "tsx src/index.tsx",
    "build": "npm run build:audio && tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "ink": "7.0.1",
    "marked": "14.1.4",
    "marked-terminal": "7.3.0",
    "react": "^19.2.5",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/ws": "^8.5.13",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
